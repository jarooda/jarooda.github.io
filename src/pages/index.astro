---
import BaseHead from "../components/shared/BaseHead.astro"
import RoomApp from "../components/room/RoomApp"
import RoomContent from "../components/room/RoomContent.astro"
import RoomGate from "../components/room/RoomGate.astro"
import RoomSplash from "../components/room/RoomSplash.astro"
import { getRoomData } from "../data/room"
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts"
import "../styles/index.css"
import "../styles/base.css"
import "../styles/blogs.css"

// No ClientRouter here: leaving the page must be a full reload so the WebGL context is released.
const data = await getRoomData()
const title = `${SITE_TITLE} - Frontend Developer`
---

<!doctype html>
<html lang="en">
  <head>
    <RoomGate />
    <BaseHead title={title} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <RoomSplash />
    <div class="room-background" aria-hidden="true"></div>
    <div class="room-weather-flash" aria-hidden="true"></div>
    <RoomApp client:only="react" data={data} />
    <!-- After the island so the quick menu stays the first Tab stop (decision 6). -->
    <RoomContent data={data} />
  </body>
</html>

<style is:global>
  /* Registered so the phase-driven gradient transitions smoothly. */
  @property --room-bg-top {
    syntax: "<color>";
    inherits: true;
    initial-value: #f6e7cf;
  }

  @property --room-bg-bottom {
    syntax: "<color>";
    inherits: true;
    initial-value: #e8c9a0;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    font-family: "Lato", sans-serif;
  }

  .room-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, var(--room-bg-top) 0%, var(--room-bg-bottom) 100%);
    transition:
      --room-bg-top 1.2s ease,
      --room-bg-bottom 1.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .room-background,
    .room-splash {
      transition: none;
    }
  }

  /* Live weather (V3): rain across the whole page, not only through the window (user feedback).
     Same stacking tier as .room-background, below the transparent canvas, so the diorama draws
     over it. Drops are generated by ui/PageRain.tsx; the container is rotated to the shared
     wind angle, oversized so its rotated corners still cover the viewport. */
  .room-page-rain {
    position: fixed;
    inset: -25%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    transition: opacity 0.8s ease;
  }

  .room-drop {
    position: absolute;
    top: 0;
    width: 2px;
    border-radius: 0 0 1px 1px;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), rgb(255 255 255 / 0.85));
    animation: room-drop-fall linear infinite;
    will-change: transform;
  }

  @keyframes room-drop-fall {
    from {
      transform: translateY(-10vh);
    }
    to {
      transform: translateY(160vh);
    }
  }

  /* Storm lightning (driven by the same `lightning.strength` the window/sky use). */
  .room-weather-flash {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: #fff;
    opacity: 0;
  }

  /* Reduced motion: still drops, spread over the page (same as the window's static rain). */
  @media (prefers-reduced-motion: reduce) {
    .room-drop {
      animation: none;
      transform: translateY(var(--drop-y));
    }
  }

  .room-canvas {
    position: fixed;
    inset: 0;
    z-index: 1;
  }

  .room-label {
    display: inline-block;
    white-space: nowrap;
    transform: translateY(-120%);
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
    background: rgb(17 24 39 / 0.85);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .room-canvas canvas {
    touch-action: none;
  }


  .room-prose > :first-child {
    margin-top: 0;
  }

  .room-noscript {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-content: center;
    gap: 0.5rem;
    background: #f3f4f6;
    color: #374151;
    text-align: center;
  }
</style>
